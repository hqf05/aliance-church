{
  "name": "aliance_chruch",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && prisma migrate deploy && next build",
    "start": "next start -p 3000",
    "postinstall": "prisma generate",
    "lint": "eslint",
    "electron": "cross-env ELECTRON_START_URL=http://localhost:3000 electron .",
    "dev:electron": "concurrently \"next dev\" \"wait-on http://localhost:3000 && npm run electron\"",
    "prod:electron": "node electron/run-prod.cjs",
    "pack": "next build && electron-builder --dir",
    "dist": "next build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "pack:mac": "npm run build && electron-builder --mac --dir"
  },
  "build": {
    "appId": "com.aliance.church",
    "productName": "Aliance Church",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      ".next/**/*",
      "public/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    }
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.6",
    "@mui/material": "^7.3.6",
    "@prisma/client": "^6.19.1",
    "next": "16.0.10",
    "playwright": "^1.57.0",
    "prisma": "^6.19.1",
    "react": "19.2.1",
    "react-dom": "19.2.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.33",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^40.4.0",
    "electron-builder": "^26.7.0",
    "eslint": "^9",
    "eslint-config-next": "16.0.10",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "wait-on": "^9.0.4"
  }
}
